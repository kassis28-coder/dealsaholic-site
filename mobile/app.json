{
  "expo": {
    "name": "Deals-aholic",
    "slug": "deals-aholic",
    "version": "1.0.0",
    "description": "Fresh online deals, promo codes, and price drops in one place.",
    "orientation": "portrait",
    "icon": "./assets/images/deals-aholic-icon-v2.png",
    "scheme": "dealsaholic",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.dealsaholic.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#090909",
        "foregroundImage": "./assets/images/deals-aholic-icon-v2.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.dealsaholic.app"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-notifications",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/deals-aholic-icon-v2.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#090909",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "10dc29c9-0a48-4b4d-9d99-26993f545589"
      }
    },
    "owner": "deals-aholic"
  }
}
